# conformance: valid — §4.2 three levels, ids by path, references by suffix
# expect: objects=8 relations=2 placements=0
# expect: diagnostics=none
arch shop "Shop" {
  system orders "Orders" {
    service api "API" {
      component http "HTTP layer"
      component domain "Domain"
      http calls domain
    }
    datastore db "DB" owned_by api
  }
  system billing "Billing" {
    service api "API"
  }
  orders.api calls billing.api
}

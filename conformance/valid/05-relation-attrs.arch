# conformance: valid — §3.4 over · via · port · spec · as · label · body
# expect: objects=4 relations=2 placements=0
# expect: diagnostics=none
gateway gw "Gateway" { transit }
gateway waf "WAF" { transit }
service a "A"
service b "B"
a calls b over HTTPS via waf, gw port 8443 spec openapi://b.yaml as client "place order"
a uses b over gRPC {
  auth mtls
  ratelimit 100rps
}

# conformance: valid — §4.3 contracts by pointer
# expect: objects=2 relations=0 placements=0
# expect: diagnostics=none
service checkout "Checkout" {
  exposes http openapi://checkout.yaml @3 "public API"
  exposes grpc proto://checkout.proto
  stores schema sql://checkout.sql
}
service billing "Billing"
billing exposes http openapi://billing.yaml
